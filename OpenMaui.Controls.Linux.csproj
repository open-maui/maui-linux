<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenMaui.Platform.Linux</RootNamespace>
    <AssemblyName>OpenMaui.Controls.Linux</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0108;CS1591;CS0618</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- NuGet Package Properties -->
    <PackageId>OpenMaui.Controls.Linux</PackageId>
    <Version>10.0.110.6</Version>
    <Authors>MarketAlly Pte Ltd, David H. Friedel Jr.</Authors>
    <Company>MarketAlly Pte Ltd</Company>
    <Product>OpenMaui Linux Controls</Product>
    <Description>Linux desktop support for .NET MAUI applications using SkiaSharp rendering. Supports X11 and Wayland display servers with 50+ controls, platform services, and accessibility support.</Description>
    <Copyright>Copyright 2025-2026 MarketAlly Pte Ltd</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/open-maui/maui-linux</PackageProjectUrl>
    <RepositoryUrl>https://github.com/open-maui/maui-linux.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>maui;linux;desktop;skia;gui;cross-platform;dotnet;x11;wayland;openmaui</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo_only.png</PackageIcon>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>

    <!-- Stable-contract gate (docs/VERSIONING.md): `dotnet pack` compares the
         public API against the last released package and fails on an
         unrecorded break. Intentional breaks are recorded in
         CompatibilitySuppressions.xml (regenerate with
         -p:ApiCompatGenerateSuppressionFile=true) and listed in CHANGELOG.md.
         Bump the baseline to the new version after each release. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>10.0.110.5</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- OpenMaui.Hosting provides the cross-platform UseLinux() stub -->
  <ItemGroup>
    <ProjectReference Include="Hosting.Abstractions/OpenMaui.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MAUI Core packages -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.110" />
    <PackageReference Include="Microsoft.Maui.Graphics.Skia" Version="10.0.110" />

    <!-- SkiaSharp for rendering (4.x — SKFont text API; legacy SKPaint text members are error-obsolete) -->
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.Views.Desktop.Common" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.Views.Maui.Core" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.152.1" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />

    <!-- HarfBuzz for advanced text shaping -->
    <PackageReference Include="HarfBuzzSharp" Version="14.2.1.201" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.201" />

    <!-- Harmony for patching MAUI Essentials stubs with Linux implementations -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />

    <!-- Managed D-Bus client for the Fcitx5 input-method frontend (typed
         proxies + signal watchers; replaces the dbus-monitor subprocess) -->
    <PackageReference Include="Tmds.DBus" Version="0.94.2" />

    <!-- Note: MediaElement support lives in the sibling package
         OpenMaui.Controls.Linux.MediaElement, NOT here. Adding the
         CommunityToolkit.Maui.MediaElement reference to this package
         would force every consumer to pull ~140KB of MediaElement DLL even
         if they never use it. The opt-in sibling references both this
         package and the toolkit, ships the LinuxMediaElementHandler + Skia
         + GStreamer wiring, and exposes `UseLinuxMediaElement()`. -->
  </ItemGroup>

  <!-- Include README and icon in package -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="assets/logo_only.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Wayland protocol bindings — generated from wayland-protocols XML via
       wayland-scanner and compiled into a small shared library. Shipped as a
       runtime native asset so consuming apps don't need wayland-scanner at
       build time. See native/build.sh for regeneration. -->
  <ItemGroup>
    <None Include="native/libopenmaui_wl.so" Condition="Exists('native/libopenmaui_wl.so')">
      <Pack>true</Pack>
      <PackagePath>runtimes/linux-x64/native/libopenmaui_wl.so</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libopenmaui_wl.so</Link>
    </None>
    <!-- aarch64 build of the same shim (native/build.sh cross-builds it). In
         the package it is the linux-arm64 runtime asset; in a source build it
         lands in runtimes/linux-arm64/native/ under the output, which
         WaylandWindow.TryLoadProtocols probes after the x64 copy next to the
         assembly fails to dlopen on an arm64 host. -->
    <None Include="native/linux-arm64/libopenmaui_wl.so" Condition="Exists('native/linux-arm64/libopenmaui_wl.so')">
      <Pack>true</Pack>
      <PackagePath>runtimes/linux-arm64/native/libopenmaui_wl.so</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes/linux-arm64/native/libopenmaui_wl.so</Link>
    </None>
  </ItemGroup>

  <!-- Include build props and targets in package - auto-imports when package is referenced -->
  <!-- .props runs BEFORE the project (sets SingleProject=false, RuntimeIdentifiers) -->
  <!-- .targets runs AFTER the project (manages platform folder exclusions, copies assets) -->
  <ItemGroup>
    <None Include="build\OpenMaui.Controls.Linux.props" Pack="true" PackagePath="build\OpenMaui.Controls.Linux.props" />
    <None Include="build\OpenMaui.Controls.Linux.targets" Pack="true" PackagePath="build\OpenMaui.Controls.Linux.targets" />
  </ItemGroup>

  <!-- Exclude old handler files, samples, templates, and VSIX -->
  <ItemGroup>
    <Compile Remove="Hosting.Abstractions/**/*.cs" />
    <Compile Remove="Handlers/*.Linux.cs" />
    <Compile Remove="MediaElement/**/*.cs" />
    <Compile Remove="Pdf/**/*.cs" />
    <Compile Remove="Maps/**/*.cs" />
    <Compile Remove="Syncfusion/**/*.cs" />
    <Compile Remove="Blazor/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
    <Compile Remove="samples/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="templates/**/*.cs" />
    <Compile Remove="vsix/**/*.cs" />
    <None Remove="vsix/**/*.xaml" />
    <None Remove="templates/**/*.xaml" />
    <None Remove="samples/**/*.xaml" />
    <MauiXaml Remove="vsix/**/*.xaml" />
    <MauiXaml Remove="templates/**/*.xaml" />
    <MauiXaml Remove="samples/**/*.xaml" />
  </ItemGroup>

</Project>
