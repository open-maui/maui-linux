<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compares two ParityHarness dump folders; usage in ../README.md and Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ParityHarness.Diff</RootNamespace>
    <AssemblyName>ParityHarness.Diff</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Screenshot comparison (Visual.cs): the same SkiaSharp OpenMaui renders with. -->
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.1" />
  </ItemGroup>
</Project>
