<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless performance suite and regression gate; usage in docs/PERFORMANCE.md
       and at the top of Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The platform assembly grants this name InternalsVisibleTo (WindowContext,
         LinuxTicker, Egl, ...), the same seams the test project uses. -->
    <AssemblyName>OpenMaui.Benchmarks</AssemblyName>
    <RootNamespace>OpenMaui.Benchmarks</RootNamespace>
    <NoWarn>$(NoWarn);CS0618;CS0067</NoWarn>
    <!-- Fewer moving parts between runs: workstation, non-concurrent GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OpenMaui.Controls.Linux.csproj" />
  </ItemGroup>
</Project>
