    <MauiControlsFile Include="Elements/TabbedPage/TabbedPageTests.cs" />
    <MauiControlsFile Include="Elements/TemplatedView/TemplatedViewTests.cs" />
    <MauiControlsFile Include="Elements/Toolbar/ToolbarTests.cs" />
    <MauiControlsFile Include="Elements/View/ViewTests.cs" />
    <MauiControlsFile Include="Elements/VisualElementTree/VisualElementTreeTests.cs" />
    <MauiControlsFile Include="Elements/VisualElementTree/FindVisualTreeElementInsideTestCase.cs" />
    <MauiControlsFile Include="Elements/Window/WindowTests.cs" />
    <MauiControlsFile Include="Elements/Window/WindowOverlayTests.cs" />
    <MauiControlsFile Include="Elements/Window/WindowPageSwapTestCases.cs" />
    <MauiControlsFile Include="Elements/Window/ChangingToNewMauiContextDoesntCrashTestCases.cs" />
    <MauiControlsFile Include="Memory/MemoryTests.cs" />
  </ItemGroup>

  <!--
    Build-time compile fixes (MauiPatches.props): a few MAUI files do not compile
    on the platform-neutral TFM as they are (a platform #if with no fallback
    branch, a constraint that names IPlatformViewHandler next to IViewHandler).
    Such a file is compiled from a copy under obj/ with the listed literal
    replacements applied; every replacement must match or the build fails, and
    none changes what a test asserts. Nothing is written to the repository.
  -->
  <Import Project="MauiPatches.props" />

  <UsingTask TaskName="ApplyMauiPatches" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Patches ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <SourceRoot ParameterType="System.String" Required="true" />
      <OutputRoot ParameterType="System.String" Required="true" />
      <PatchedFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var outputs = new List<Microsoft.Build.Framework.ITaskItem>();
        foreach (var group in Patches.GroupBy(p => p.ItemSpec))
        {
            // A key may climb out of the Controls tests (../../../Core/tests/DeviceTests.Shared/...):
            // the original is named by its full path, the copy keeps the path below the climb.
            var source = Path.GetFullPath(Path.Combine(SourceRoot, group.Key));
            var relative = group.Key.Replace("\\", "/");
            while (relative.StartsWith("../", StringComparison.Ordinal))
                relative = relative.Substring(3);
            var text = File.ReadAllText(source);
            foreach (var patch in group)
            {
                var find = patch.GetMetadata("Find").Replace("\\n", "\n").Replace("\\t", "\t");
                var replace = patch.GetMetadata("Replace").Replace("\\n", "\n").Replace("\\t", "\t");
                // MAUI's sources use CRLF in places; match either.
                var normalized = text.Replace("\r\n", "\n");
                if (!normalized.Contains(find))
                {
                    Log.LogError("MAUI patch for " + group.Key + " no longer matches: " + find);
                    continue;
                }
                text = normalized.Replace(find, replace);
            }
            var target = Path.Combine(OutputRoot, relative);
            Directory.CreateDirectory(Path.GetDirectoryName(target));
            if (!File.Exists(target) || File.ReadAllText(target) != text)
                File.WriteAllText(target, text);
            var item = new Microsoft.Build.Utilities.TaskItem(target);
            item.SetMetadata("Original", source);
            item.SetMetadata("Link", (relative == group.Key ? "Maui/Controls/" : "Maui/Shared/") + relative);
            outputs.Add(item);
        }
        PatchedFiles = outputs.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ApplyMauiPatches" BeforeTargets="CoreCompile;CoreGenerateAssemblyInfo" Condition="'$(MauiSourcesPresent)' == 'true' and '@(MauiPatch)' != ''">
    <ApplyMauiPatches Patches="@(MauiPatch)" SourceRoot="$(MauiControlsTests)" OutputRoot="$(IntermediateOutputPath)MauiPatched/">
      <Output TaskParameter="PatchedFiles" ItemName="_MauiPatchedFile" />
    </ApplyMauiPatches>
    <ItemGroup>
      <Compile Remove="@(_MauiPatchedFile->'%(Original)')" />
      <Compile Include="@(_MauiPatchedFile)" />
    </ItemGroup>
  </Target>

  <!-- ===================== Without the MAUI clone ===================== -->
  <ItemGroup Condition="'$(MauiSourcesPresent)' != 'true'">
    <Compile Remove="**/*.cs" />
    <Compile Remove="@(Compile)" />
    <Compile Include="../MauiSourcesMissing.cs" Link="MauiSourcesMissing.cs" />
    <Compile Include="Infrastructure/AssemblyName.Controls.cs" />
  </ItemGroup>
  <Target Name="WarnMauiSourcesMissing" BeforeTargets="CoreCompile" Condition="'$(MauiSourcesPresent)' != 'true'">
    <Warning Text="MAUI test sources not found at '$(MauiSrc)'. The Controls conformance suite is reduced to one skipped test. Run tests/Conformance/get-maui-sources.sh or pass -p:MauiSrc=..." />
  </Target>

  <!-- ===================== With the MAUI clone ===================== -->
  <ItemGroup Condition="'$(MauiSourcesPresent)' == 'true'">
    <!-- TestUtils/src/DeviceTests (xUnitCustomizations.cs is replaced by the shared Linux one) -->
    <Compile Include="$(MauiTestUtils)AssertHelpers.cs" Link="Maui/TestUtils/%(Filename)%(Extension)" />
    <Compile Include="$(MauiTestUtils)AssertionExtensions.cs" Link="Maui/TestUtils/%(Filename)%(Extension)" />

    <!-- DeviceTests.Shared: the handler test base and stubs (what Controls.DeviceTests references) -->
    <Compile Include="$(MauiSharedTests)GlobalNamespaces.cs" Link="Maui/Shared/%(Filename)%(Extension)" />
    <Compile Include="$(MauiSharedTests)HandlerTests/TestBase.cs" Link="Maui/Shared/%(Filename)%(Extension)" />
    <Compile Include="$(MauiSharedTests)HandlerTests/HandlerTestBasement.cs" Link="Maui/Shared/%(Filename)%(Extension)" />
    <Compile Include="$(MauiSharedTests)HandlerTests/HandlerTestBase.cs" Link="Maui/Shared/%(Filename)%(Extension)" />
    <Compile Include="$(MauiSharedTests)Stubs/*.cs" Link="Maui/Shared/Stubs/%(Filename)%(Extension)" />
    <Compile Include="$(MauiSharedTests)ImageAnalysis/*.cs" Link="Maui/Shared/ImageAnalysis/%(Filename)%(Extension)" />

    <!-- The Controls test files under test -->
    <Compile Include="@(MauiControlsFile->'$(MauiControlsTests)%(Identity)')" Link="Maui/Controls/%(Identity)" />

    <!-- The pictures the tests load by name (MAUI ships them in its device-test app). -->
    <Content Include="$(MauiControlsTests)Resources/Images/*.png" Exclude="$(MauiControlsTests)Resources/Images/red-embedded.png" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="$(MauiControlsTests)Resources/Images/red-embedded.png" LogicalName="red-embedded.png" Link="Resources/red-embedded.png" />
    <!-- MAUI's test app also ships white.png as white_tab.png (a MauiImage link), the Shell tab icon. -->
    <Content Include="$(MauiControlsTests)Resources/Images/white.png" Link="white_tab.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
