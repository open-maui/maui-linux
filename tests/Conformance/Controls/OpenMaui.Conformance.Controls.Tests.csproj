    src/Controls/tests/DeviceTests). Platform partials (*.Android.cs, *.iOS.cs,
    *.Windows.cs) are never compiled; their Linux counterparts live in Elements/.
  -->
  <ItemGroup>
    <!-- base classes, shared helpers and test data -->
    <MauiControlsFile Include="ControlsHandlerTestBase.cs" />
    <MauiControlsFile Include="Extensions.cs" />
    <MauiControlsFile Include="TestCategory.cs" />
    <MauiControlsFile Include="TextTransformCases.cs" />
    <MauiControlsFile Include="Stubs/ApplicationStub.cs" />
    <MauiControlsFile Include="Stubs/FrameStub.cs" />
    <MauiControlsFile Include="TestClasses/LifeCycleTrackingPage.cs" />
    <MauiControlsFile Include="TestClasses/FlyoutPageAlwaysSplit.cs" />
    <MauiControlsFile Include="TestClasses/NestingView.cs" />
    <MauiControlsFile Include="TestCases/ControlsPageTypesTestCases.cs" />
    <MauiControlsFile Include="TestCases/ControlsViewTypesTestCases.cs" />
    <!-- tests -->
    <MauiControlsFile Include="MapperTests.cs" />
    <MauiControlsFile Include="DispatchingTests.cs" />
    <MauiControlsFile Include="Elements/FormattedStringTests.cs" />
    <MauiControlsFile Include="Elements/PlatformBehaviorTests.cs" />
    <MauiControlsFile Include="Elements/VisualElementTests.cs" />
    <MauiControlsFile Include="Elements/Application/ApplicationTests.cs" />
    <MauiControlsFile Include="Elements/Border/BorderTests.cs" />
    <MauiControlsFile Include="Elements/BoxView/BoxViewTests.cs" />
    <MauiControlsFile Include="Elements/Button/ButtonTests.cs" />
    <MauiControlsFile Include="Elements/CheckBox/CheckBoxTests.cs" />
    <MauiControlsFile Include="Elements/ContentView/ContentViewTests.cs" />
    <MauiControlsFile Include="Elements/Editor/EditorTests.cs" />
    <MauiControlsFile Include="Elements/Entry/EntryTests.cs" />
    <MauiControlsFile Include="Elements/Image/ImageTests.cs" />
    <MauiControlsFile Include="Elements/Label/LabelTests.cs" />
    <MauiControlsFile Include="Elements/Layout/LayoutTests.cs" />
    <MauiControlsFile Include="Elements/Picker/PickerTests.cs" />
    <MauiControlsFile Include="Elements/RadioButton/RadioButtonTests.cs" />
    <MauiControlsFile Include="Elements/ScrollView/ScrollViewTests.cs" />
    <MauiControlsFile Include="Elements/SearchBar/SearchBarTests.cs" />
    <MauiControlsFile Include="Elements/Slider/SliderTests.cs" />
    <MauiControlsFile Include="Elements/TextInput/TextInputTests.cs" />
    <MauiControlsFile Include="Elements/Accessibility/AccessibilityTests.cs" />
    <MauiControlsFile Include="Elements/CarouselView/CarouselViewTests.cs" />
    <MauiControlsFile Include="Elements/CollectionView/CollectionViewTests.cs" />
    <MauiControlsFile Include="Elements/CollectionView/CollectionViewSizingTestCase.cs" />
    <MauiControlsFile Include="Elements/DatePicker/DatePickerTests.cs" />
    <MauiControlsFile Include="Elements/FlyoutPage/FlyoutPageTests.cs" />
    <MauiControlsFile Include="Elements/FlyoutPage/FlyoutPageLayoutBehaviorTestCases.cs" />
    <MauiControlsFile Include="Elements/Frame/FrameTests.cs" />
    <MauiControlsFile Include="Elements/Frame/FrameHandlerTest.cs" />
    <MauiControlsFile Include="Elements/Modal/ModalTests.cs" />
    <MauiControlsFile Include="Elements/NavigationPage/NavigationPageTests.cs" />
    <MauiControlsFile Include="Elements/Page/PageTests.cs" />
