<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MAUI Controls conformance suite.

    Compiles dotnet/maui's OWN Controls device tests (src/Controls/tests/DeviceTests,
    tag 10.0.110) against OpenMaui: real Controls views (Label, Entry, CollectionView,
    Shell, NavigationPage, ...) hosted in a window the way an app hosts them, with
    MAUI's assertions as the specification. The MAUI sources are NOT vendored: they
    are compiled in place from the same local clone the Core suite uses (MIT
    licensed, file contents untouched).

      MauiSrc   Root of a dotnet/maui checkout at the tag the platform targets.
                Default: $(HOME)/.cache/openmaui-build/maui-src
                Populate it with tests/Conformance/get-maui-sources.sh.

    Why a second project (and not more files in the Core one): MAUI's Controls
    assembly grants InternalsVisibleTo to "Microsoft.Maui.Controls.DeviceTests", not
    to the Core device-test assembly, and the Controls tests use those internals
    (IsLoadedOnPlatform, HasNavigatedTo, Window.IsActivated, ...). The two suites
    also host views differently: the Core suite lays a lone platform view out once,
    the Controls suite runs a real OpenMaui main thread (GLib loop, LinuxDispatcher)
    with frames, so pages load, lay out and navigate as in an app.

    Shared with the Core suite (linked from ../Infrastructure): the xunit framework
    and skip mechanism, the Skia assertion/pixel helpers.
    Controls-only (Infrastructure/ here): the main-thread test runner, the headless
    window host, MAUI handler names as global aliases of the Linux handlers
    (HandlerAliases.Controls.cs), the Linux ControlsHandlerTestBase partial and the
    per-element helper partials (Elements/*.Linux.cs).

    Run:  dotnet test tests/Conformance/Controls/OpenMaui.Conformance.Controls.Tests.csproj
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Microsoft.Maui.DeviceTests</RootNamespace>
    <!-- The name of MAUI's own Controls device-test app: Microsoft.Maui.Controls and
         Microsoft.Maui (net10.0) grant it InternalsVisibleTo. -->
    <AssemblyName>Microsoft.Maui.Controls.DeviceTests</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0618;CS0672;CS0108;CS0114;CS0162;CS0168;CS0219;CS0414;CS0649;CS0169;CS1998;CS8632;CS0105;CS4014;CS0067;CS0659;CS0661;CS0660;CS1717;CS0436;CA1416;xUnit1013;xUnit1026;xUnit2000;xUnit2009;xUnit1030;xUnit1031;xUnit1012;xUnit2013;xUnit1025;xUnit1004;xUnit2002;xUnit2005;xUnit2007;xUnit2015;xUnit2017;xUnit2020;xUnit1051;xUnit1042;xUnit1048;xUnit2012;xUnit2029;xUnit2031;MCTME001</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);OPENMAUI_LINUX;OPENMAUI_CONTROLS_CONFORMANCE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <MauiSrc Condition="'$(MauiSrc)' == ''">$(HOME)/.cache/openmaui-build/maui-src</MauiSrc>
    <!-- A property set on the command line (-p:MauiSrc=...) cannot be reassigned here, so the
         trailing slash goes on a property of its own. -->
    <MauiSrcDir>$([MSBuild]::EnsureTrailingSlash('$(MauiSrc)'))</MauiSrcDir>
    <MauiControlsTests>$(MauiSrcDir)src/Controls/tests/DeviceTests/</MauiControlsTests>
    <MauiSharedTests>$(MauiSrcDir)src/Core/tests/DeviceTests.Shared/</MauiSharedTests>
    <MauiTestUtils>$(MauiSrcDir)src/TestUtils/src/DeviceTests/</MauiTestUtils>
    <MauiSourcesPresent Condition="Exists('$(MauiControlsTests)ControlsHandlerTestBase.cs')">true</MauiSourcesPresent>
    <SharedInfra>../Infrastructure/</SharedInfra>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\OpenMaui.Controls.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Infrastructure shared with the Core suite (see ../Infrastructure). -->
  <ItemGroup>
    <SharedInfraFile Include="AssertionExtensions.Linux.cs;LinuxInput.cs;LinuxTestFramework.cs;PlatformImageLoadingService.Linux.cs;XunitCustomizations.Linux.cs" />
    <Compile Include="@(SharedInfraFile->'$(SharedInfra)%(Identity)')" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

