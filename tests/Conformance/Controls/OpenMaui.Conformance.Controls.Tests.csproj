    <MauiControlsFile Include="Elements/Shell/ShellBasicNavigationTestCases.cs" />
    <MauiControlsFile Include="Elements/Shell/ShellFlyoutTests.cs" />
    <MauiControlsFile Include="Elements/Shell/ShellFlyoutHeaderBehaviorTestCases.cs" />
    <MauiControlsFile Include="Elements/Shell/ShellFlyoutHeaderBehaviorAndContentTestCases.cs" />
    <MauiControlsFile Include="Elements/Shell/ShellFlyoutHeaderScrollTestCases.cs" />
    <MauiControlsFile Include="Elements/Shell/ShellFlyoutItemTextColorTests.cs" />
    <MauiControlsFile Include="Elements/Shell/ShellFlyoutTemplatePartsTestCases.cs" />
    <MauiControlsFile Include="Elements/Shell/ShellTabBarTests.cs" />
