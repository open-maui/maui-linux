<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The MediaElement reference brings the toolkit's builder-order analyzer;
         the handler tests build MauiApps without MediaElement on purpose. -->
    <NoWarn>$(NoWarn);MCTME001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <!-- Match main project SkiaSharp version for native library compatibility -->
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenMaui.Controls.Linux.csproj" />
    <ProjectReference Include="..\Maps\OpenMaui.Controls.Linux.Maps.csproj" />
    <ProjectReference Include="..\MediaElement\OpenMaui.Controls.Linux.MediaElement.csproj" />
    <!-- WebView scenarios run out of process (WebKit needs the main thread);
         the host is built with the tests and lands next to them. -->
    <ProjectReference Include="WebViewHost\WebViewHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="WebViewHost\**" />
    <!-- Third-party compatibility suite is its own project (tests/Compat). -->
    <Compile Remove="Compat\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The platform has process-global state (Application.Current, the GLib main
         context, WebKit's main-thread rule); collections run serially. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sample pages rendered as golden scenes (copied from maui-linux-samples). -->
    <EmbeddedResource Include="Golden\SamplePages\*.xml" LogicalName="SamplePages.%(Filename).xml" />
  </ItemGroup>
</Project>
