<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenMauiLinuxApp</RootNamespace>
    <AssemblyName>OpenMauiLinuxApp</AssemblyName>
    <ApplicationTitle>OpenMauiLinuxApp</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenMaui: UseLinux() stub (safe no-op on non-Linux platforms) -->
    <PackageReference Include="OpenMaui.Hosting" Version="10.0.*" />
    <!-- OpenMaui: Full Linux platform (handlers, services, rendering), for the Linux (plain
         net10.0) target only. It also sets that target's linux-x64/linux-arm64 runtime
         identifiers. Add net10.0-android and the other MAUI targets to TargetFrameworks as in
         any MAUI app: they build with MAUI as usual and never get the Linux platform. -->
    <PackageReference Include="OpenMaui.Controls.Linux" Version="10.0.*" Condition="!$(TargetFramework.Contains('-'))" />

    <!-- Core MAUI packages -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.*" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.*" />
  </ItemGroup>

  <!-- Linux platform files: only compiled for the Linux target, built on Linux (the other
       targets have their own entry points under Platforms/, as in any MAUI app). -->
  <ItemGroup Condition="$(TargetFramework.Contains('-')) Or !$([MSBuild]::IsOSPlatform('Linux'))">
    <Compile Remove="Platforms\Linux\**" />
    <None Remove="Platforms\Linux\**" />
  </ItemGroup>

  <!-- Resources: use MAUI item types so they get processed properly. A blanket
       EmbeddedResource glob will collide with MauiXaml-embedded resource IDs
       when consumers add XAML files under Resources/. -->
  <ItemGroup>
    <MauiFont Include="Resources\Fonts\*" />
    <MauiImage Include="Resources\Images\*" Exclude="Resources\Images\*.md;Resources\Images\.gitkeep" />
  </ItemGroup>

  <!-- Packaging for distribution: package this app as a Linux AppImage with
       `dotnet tool install -g OpenMaui.AppImage` then
       `openmaui-appimage -p .`
       (single-dash forms: an XML comment may not contain a double hyphen).
       Full guide (options, CI, signing, host-dependency checks) — intended for
       humans and AI assistants alike:
       https://github.com/open-maui/appimage/blob/main/docs/PACKAGING-GUIDE.md -->
</Project>
