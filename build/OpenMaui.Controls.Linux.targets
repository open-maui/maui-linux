<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    OpenMaui Linux Build Targets
    Handles MauiImage and MauiIcon items for Linux platform since we don't use the full MAUI SDK targets.
    Also manages platform folder exclusions so developers don't need boilerplate in their csproj.
  -->

  <!--
    Platform folder management: On Linux, exclude other platform folders.
    On non-Linux, exclude the Linux platform folder.
    This runs after the project file, so it adds Remove items for platform folders
    that don't apply to the current build host.
  -->
  <!--
    On Linux: If SingleProject was true (set by the consuming project), MAUI's
    SingleProject.targets will have marked ALL Platforms/** files as ExcludeFromCurrentConfiguration=true.
    We undo this for Platforms/Linux/ and remove the other platform folders entirely.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <!-- Override SingleProject to false — prevents MAUI targets from interfering further -->
    <SingleProject>false</SingleProject>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <!-- Re-include Linux platform files that MAUI's SingleProject.targets excluded -->
    <Compile Update="Platforms\Linux\**\*$(DefaultLanguageSourceExtension)"
             Condition="Exists('Platforms\Linux\')">
      <ExcludeFromCurrentConfiguration>false</ExcludeFromCurrentConfiguration>
    </Compile>

    <!-- Remove other platform folders -->
    <Compile Remove="Platforms\Windows\**" />
    <Compile Remove="Platforms\Android\**" />
    <Compile Remove="Platforms\iOS\**" />
    <Compile Remove="Platforms\MacCatalyst\**" />
    <Compile Remove="Platforms\Tizen\**" />
    <None Remove="Platforms\Windows\**" />
    <None Remove="Platforms\Android\**" />
    <None Remove="Platforms\iOS\**" />
    <None Remove="Platforms\MacCatalyst\**" />
    <None Remove="Platforms\Tizen\**" />
    <MauiXaml Remove="Platforms\Windows\**" />
    <MauiXaml Remove="Platforms\Android\**" />
    <MauiXaml Remove="Platforms\iOS\**" />
    <MauiXaml Remove="Platforms\MacCatalyst\**" />
    <MauiXaml Remove="Platforms\Tizen\**" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Linux'))">
    <Compile Remove="Platforms\Linux\**" />
    <None Remove="Platforms\Linux\**" />
    <MauiXaml Remove="Platforms\Linux\**" />
  </ItemGroup>

  <!--
    Deploy the Wayland protocol shim (libopenmaui_wl.so) next to the consuming
    app's assemblies. The WaylandWindow loader does an explicit dlopen() on the
    path adjacent to OpenMaui.Controls.Linux.dll, then on
    runtimes/linux-x64/native/ and runtimes/linux-arm64/native/ under it.

    With a RuntimeIdentifier (dotnet publish -r linux-x64 / linux-arm64, the
    AppImage packager) NuGet already copies the matching RID's native asset to
    the output root, so nothing is added here: copying a fixed architecture
    here used to overwrite the arm64 shim with the x64 one in a linux-arm64
    publish, and Wayland failed to start on arm64.

    Without a RuntimeIdentifier (portable framework-dependent build) NuGet
    puts both RIDs under runtimes/<rid>/native/ and this copies the shim for
    the build machine's architecture next to the assembly; on another
    architecture the loader falls through to the runtimes/ copies.

    $(MSBuildThisFileDirectory) resolves to <pkg>/build/ at consumer build time,
    so ../runtimes/<rid>/native/libopenmaui_wl.so points at the packaged native
    asset. The Exists guard means non-Linux hosts / older packages no-op cleanly.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) AND '$(RuntimeIdentifier)' == ''">
    <_OpenMauiWlRid>linux-x64</_OpenMauiWlRid>
    <_OpenMauiWlRid Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-arm64</_OpenMauiWlRid>
    <_OpenMauiWlShim>$(MSBuildThisFileDirectory)..\runtimes\$(_OpenMauiWlRid)\native\libopenmaui_wl.so</_OpenMauiWlShim>
  </PropertyGroup>
  <ItemGroup Condition="'$(_OpenMauiWlShim)' != '' AND Exists('$(_OpenMauiWlShim)')">
    <None Include="$(_OpenMauiWlShim)">
      <Link>libopenmaui_wl.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
      <Pack>false</Pack>
    </None>
  </ItemGroup>

  <!-- Copy MauiImage items to output directory after Build -->
  <Target Name="CopyMauiImagesToOutput" AfterTargets="Build" Condition="@(MauiImage) != ''">
    <Message Importance="normal" Text="OpenMaui: Copying MauiImage items to output..." />
    <Copy SourceFiles="@(MauiImage)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy MauiImage items to publish directory after Publish -->
  <Target Name="CopyMauiImagesToPublish" AfterTargets="Publish" Condition="@(MauiImage) != ''">
    <Message Importance="normal" Text="OpenMaui: Copying MauiImage items to publish folder..." />
    <Copy SourceFiles="@(MauiImage)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Copy MauiFont items next to the app. MAUI's Resizetizer only stages fonts
    under obj/ on the generic TFM (it embeds/bundles them for Android, iOS,
    Windows and Tizen only), so without this copy ConfigureFonts(AddFont(...))
    has nothing to load. LinuxFontRegistrar probes $(OutputPath)/Resources/Fonts
    first, then the output root.
  -->
  <Target Name="CopyMauiFontsToOutput" AfterTargets="Build" Condition="@(MauiFont) != ''">
    <Message Importance="normal" Text="OpenMaui: Copying MauiFont items to output..." />
    <Copy SourceFiles="@(MauiFont)" DestinationFolder="$(OutputPath)Resources/Fonts" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyMauiFontsToPublish" AfterTargets="Publish" Condition="@(MauiFont) != ''">
    <Message Importance="normal" Text="OpenMaui: Copying MauiFont items to publish folder..." />
    <Copy SourceFiles="@(MauiFont)" DestinationFolder="$(PublishDir)Resources/Fonts" SkipUnchangedFiles="true" />
  </Target>

  <!-- Process MauiIcon: copy the icon layers and write appicon.meta; the
       runtime composes appicon.png from them (Services/MauiIconGenerator.cs). -->
  <Target Name="ProcessMauiIconForOutput" AfterTargets="Build" Condition="@(MauiIcon) != ''">
    <!-- The MauiIcon file itself is the icon's background layer (for a
         single-file icon, the whole icon); ForegroundFile is drawn on top at
         ForegroundScale, tinted with Color. BackgroundColor fills behind both
         and is transparent when unset, as on the other platforms. -->
    <Copy SourceFiles="%(MauiIcon.FullPath)"
          DestinationFiles="$(OutputPath)appicon_bg%(MauiIcon.Extension)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(MauiIcon.FullPath)')" />
    <Copy SourceFiles="%(MauiIcon.ForegroundFile)"
          DestinationFiles="$(OutputPath)appicon_fg.svg"
          SkipUnchangedFiles="true"
          Condition="'%(MauiIcon.ForegroundFile)' != '' AND Exists('%(MauiIcon.ForegroundFile)')" />
    <Delete Files="$(OutputPath)appicon_fg.svg"
            Condition="'%(MauiIcon.ForegroundFile)' == ''" />

    <PropertyGroup>
      <_MauiIconScale>%(MauiIcon.ForegroundScale)</_MauiIconScale>
      <_MauiIconScale Condition="'$(_MauiIconScale)' == ''">0.65</_MauiIconScale>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(OutputPath)appicon.meta"
      Lines="Format=2;Background=appicon_bg%(MauiIcon.Extension);BackgroundColor=%(MauiIcon.BackgroundColor);TintColor=%(MauiIcon.Color);Size=256;Scale=$(_MauiIconScale)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Process MauiIcon for Publish -->
  <Target Name="ProcessMauiIconForPublish" AfterTargets="Publish" Condition="@(MauiIcon) != ''">
    <!-- The MauiIcon file itself is the icon's background layer (for a
         single-file icon, the whole icon); ForegroundFile is drawn on top at
         ForegroundScale, tinted with Color. BackgroundColor fills behind both
         and is transparent when unset, as on the other platforms. -->
    <Copy SourceFiles="%(MauiIcon.FullPath)"
          DestinationFiles="$(PublishDir)appicon_bg%(MauiIcon.Extension)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(MauiIcon.FullPath)')" />
    <Copy SourceFiles="%(MauiIcon.ForegroundFile)"
          DestinationFiles="$(PublishDir)appicon_fg.svg"
          SkipUnchangedFiles="true"
          Condition="'%(MauiIcon.ForegroundFile)' != '' AND Exists('%(MauiIcon.ForegroundFile)')" />
    <Delete Files="$(PublishDir)appicon_fg.svg"
            Condition="'%(MauiIcon.ForegroundFile)' == ''" />

    <PropertyGroup>
      <_MauiIconScale>%(MauiIcon.ForegroundScale)</_MauiIconScale>
      <_MauiIconScale Condition="'$(_MauiIconScale)' == ''">0.65</_MauiIconScale>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(PublishDir)appicon.meta"
      Lines="Format=2;Background=appicon_bg%(MauiIcon.Extension);BackgroundColor=%(MauiIcon.BackgroundColor);TintColor=%(MauiIcon.Color);Size=256;Scale=$(_MauiIconScale)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
